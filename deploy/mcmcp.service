# Template: fill in the __PLACEHOLDERS__ when installing (see README.md).
[Unit]
Description=mcmcp !design builder (AI -> OpenSCAD -> blocks over RCON)
After=network.target

[Service]
User=__USER__
WorkingDirectory=__MCMCP_DIR__
Environment=MCMCP_SERVER_DIR=__SERVER_DIR__
Environment=MCMCP_WORK_DIR=__MCMCP_DIR__/work
Environment=MCMCP_OPENSCAD=__OPENSCAD__
Environment=PATH=__PATH__
ExecStart=__MCMCP_DIR__/venv/bin/python -m mcmcp.main
Restart=on-failure
RestartSec=10
Nice=10
CPUQuota=100%
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
